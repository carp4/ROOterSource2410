# Secret hygiene: never commit the build-injected tailscale auth key.
files/etc/ts-auth-key
configfiles/z8102tail/etc/ts-auth-key

# Build output that is NOT tracked upstream. Upstream ships no .gitignore at
# all, so before this existed a blanket `git add -A` would try to stage ~1300
# untracked paths of kernel/toolchain build scratch. This reduces that to 8,
# all of them load-bearing sources.
build_dir/
staging_dir/
dl/
tmp/
bin/
logs/
images/

# Feed clones and the indexes ./build materialises from feeds.conf. The four
# upstream feeds (base, luci, packages, routing, telephony) are tracked; only
# the locally-added src-link feeds and their generated indexes are not.
feeds/*.index
feeds/*.targetindex
feeds/*.tmp/
# No trailing slash: ./build creates these two as SYMLINKS, and a dir-only
# pattern would not match them.
feeds/tailscale
feeds/zapret2
package/feeds/

# Written by ./build (it emits 'CODENAME="..."' into this path).
files/etc/codename

# Generated by ./build from the selected target's .config.
configfiles/custom/

# NOTE: these are TRACKED UPSTREAM, so no ignore rule can silence them and a
# blanket `git add -A` WILL try to stage them:
#   .config, .config.old
#   scripts/config/lexer.lex.o, feeds/luci/.../{lmo,plural_formula}.o,
#     contrib/lemon, po2lmo
#   staging_dir/host/bin/*  (~230 tracked host binaries rebuilt by every build)
#   tmp/info/*              (package indexes regenerated by every build)
#   feeds/base              (symlink; upstream's own value is already an
#                            absolute path into the upstream author's home dir,
#                            so the local one is deliberately not committed)
# They are left visible rather than hidden with update-index --skip-worktree.
# Commit build sources with explicit paths, never `git add -A`.
